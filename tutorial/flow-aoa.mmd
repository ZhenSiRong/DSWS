%% 双代号网络图（AOA / 箭线图法 ADM）—— 单代号（AON）主线的对照附录
%% 箭线 = 构建活动 A0–A9（线上标「活动编号 工期」）；节点 = 事件（圆圈内是事件编号）
%% 10 个事件 e1–e10、10 条实箭线、0 条虚活动：串并联形状，汇聚点 e6 同时收 A2 与 A6，无需虚活动
%% 关键路径：A0 → A3 → A4 → A5 → A6 → A7 → A8 → A9，总工期 61 分钟
%% 非关键：A1、A2（串行到 e6，总浮动各 22 分钟）
%% 渲染成 PNG：python3 tutorial/shots/render_aoa.py（同一份源文件供 README 附录与答辩共用）
flowchart LR
    e1((1)) -->|"A0 10"| e2((2))
    e2 -->|"A3 5"| e3((3))
    e3 -->|"A4 4"| e4((4))
    e4 -->|"A5 8"| e5((5))
    e5 -->|"A6 10"| e6((6))
    e2 -->|"A1 3"| e7((7))
    e7 -->|"A2 2"| e6
    e6 -->|"A7 6"| e8((8))
    e8 -->|"A8 10"| e9((9))
    e9 -->|"A9 8"| e10((10))

    %% 事件圆圈统一样式（浅灰底、深灰描边、深色数字）
    classDef event fill:#f6f7f9,stroke:#8a9098,stroke-width:2px,color:#333333
    class e1,e2,e3,e4,e5,e6,e7,e8,e9,e10 event

    %% linkStyle 序号 = 上面箭线的书写顺序（从 0 起）
    %% 关键路径箭线（橙色加粗）：0 A0、1 A3、2 A4、3 A5、4 A6、7 A7、8 A8、9 A9
    linkStyle 0,1,2,3,4,7,8,9 stroke:#e65100,stroke-width:4px
    %% 非关键箭线（灰色）：5 A1、6 A2
    linkStyle 5,6 stroke:#9aa0a6,stroke-width:2px
