    %% 关键路径（橙色粗边框 + 浅橙底 + 橙色粗箭头）：A0 A3 A4 A5 A6 A7 A8 A9
    %% linkStyle 的序号 = 上面箭头的书写顺序（从 0 起）
    classDef critical fill:#fff1e0,stroke:#e65100,stroke-width:5px,color:#333333
    classDef normal fill:#f6f7f9,stroke:#b6bcc4,stroke-width:2px,color:#333333
    class A0,A3,A4,A5,A6,A7,A8,A9 critical
    class A1,A2 normal
    linkStyle 1,4,5,6,7,8,9 stroke:#e65100,stroke-width:4px
    linkStyle 0,2,3 stroke:#9aa0a6,stroke-width:2px
