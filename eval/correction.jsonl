{"id": "c01", "category": "列名", "layer": "guard", "sql": "SELECT fact_order.amount FROM fact_order", "expect_code": "SQL_UNKNOWN_COLUMN", "expect": "corrected", "query": "华北销售额", "retryable": true}
{"id": "c02", "category": "列名", "layer": "guard", "sql": "SELECT SUM(fact_order.order_amount) AS gmv FROM fact_order WHERE fact_order.amount > 100", "expect_code": "SQL_UNKNOWN_COLUMN", "expect": "corrected", "query": "华北销售额", "retryable": true}
{"id": "c03", "category": "表名", "layer": "guard", "sql": "SELECT SUM(fact_sales.order_amount) FROM fact_sales", "expect_code": "SQL_UNKNOWN_TABLE", "expect": "corrected", "query": "各品类销售额", "retryable": true}
{"id": "c04", "category": "表名", "layer": "guard", "sql": "SELECT COUNT(*) FROM fact_order JOIN dim_city ON fact_order.region_id = dim_city.region_id", "expect_code": "SQL_UNKNOWN_TABLE", "expect": "corrected", "query": "各地区订单量", "retryable": true}
{"id": "c05", "category": "语法", "layer": "guard", "sql": "SELECT SUM(fact_order.order_amount FROM fact_order", "expect_code": "SQL_SYNTAX", "expect": "corrected", "query": "各地区销售额", "retryable": true}
{"id": "c06", "category": "语法", "layer": "guard", "sql": "SELEC region_name FROM dim_region", "expect_code": "SQL_SYNTAX", "expect": "corrected", "query": "各省份", "retryable": true}
{"id": "c07", "category": "别名", "layer": "guard", "sql": "SELECT SUM(fact_order.order_amount) AS gmv FROM fact_order ORDER BY total_amount", "expect_code": "SQL_UNKNOWN_COLUMN", "expect": "corrected", "query": "总销售额", "retryable": true}
{"id": "c08", "category": "结构", "layer": "guard", "sql": "SELECT dim_region.province, SUM(fact_order.order_amount) FROM fact_order JOIN dim_region ON fact_order.region_id = dim_region.region_id GROUP BY dim_region.province", "expect_code": "SQL_MISSING_ORDER_BY", "expect": "corrected", "intent": "排名", "query": "哪个省销量最高", "retryable": true}
{"id": "c09", "category": "结构", "layer": "guard", "sql": "SELECT dim_region.province, SUM(fact_order.order_amount) FROM fact_order JOIN dim_region ON fact_order.region_id = dim_region.region_id GROUP BY dim_region.province ORDER BY 2 DESC", "expect_code": "SQL_MISSING_LIMIT", "expect": "corrected", "intent": "Top 3", "query": "品牌销售额 Top 3", "retryable": true}
{"id": "c10", "category": "结构", "layer": "guard", "sql": "SELECT 'placeholder' AS gmv FROM fact_order", "expect_code": "SQL_CONSTANT_PROJECTION", "expect": "corrected", "query": "总销售额", "retryable": true}
{"id": "c11", "category": "不安全构造", "layer": "policy", "sql": "SELECT order_amount FROM fact_order UNION SELECT customer_id FROM dim_customer", "expect_code": "SQL_REJECTED", "expect_reason": "SQL_FORBIDDEN_CONSTRUCT", "expect": "rejected", "query": "用 UNION 拼接两个品类", "retryable": false}
{"id": "c12", "category": "不安全构造", "layer": "guard", "sql": "SELECT 1 AS a FROM fact_order LIMIT 1; DROP TABLE fact_order", "expect_code": "SQL_MULTIPLE_STATEMENTS", "expect": "rejected", "query": "华北销售额", "retryable": false}
{"id": "c13", "category": "不安全构造", "layer": "guard", "sql": "DELETE FROM fact_order WHERE order_id = 'O001'", "expect_code": "SQL_NOT_READ_ONLY", "expect": "rejected", "query": "删除订单", "retryable": false}
{"id": "c14", "category": "不安全构造", "layer": "policy", "sql": "SELECT LOAD_FILE('/etc/passwd') FROM fact_order", "expect_code": "SQL_REJECTED", "expect_reason": "SQL_FORBIDDEN_CONSTRUCT", "expect": "rejected", "query": "读取文件", "retryable": false}
{"id": "c15", "category": "不安全构造", "layer": "policy", "sql": "SELECT * FROM mysql.user", "expect_code": "SQL_REJECTED", "expect_reason": "SQL_TABLE_NOT_ALLOWED", "expect": "rejected", "query": "查询用户", "retryable": false}
{"id": "c16", "category": "不安全构造", "layer": "policy", "sql": "SELECT /*!50000 order_amount */ FROM fact_order", "expect_code": "SQL_REJECTED", "expect_reason": "SQL_COMMENT_OBFUSCATION", "expect": "rejected", "query": "销售额", "retryable": false}
{"id": "c17", "category": "不安全构造", "layer": "policy", "sql": "SELECT dim_customer.phone FROM dim_customer", "expect_code": "SQL_REJECTED", "expect_reason": "SQL_COLUMN_NOT_ALLOWED", "expect": "rejected", "query": "客户手机号", "retryable": false}
{"id": "c18", "category": "结构", "layer": "guard", "sql": "   ", "expect_code": "SQL_EMPTY", "expect": "rejected", "query": "华北销售额", "retryable": false}
{"id": "c19", "category": "结构", "layer": "guard", "sql": "WITH d AS (DELETE FROM fact_order RETURNING order_id) SELECT * FROM d", "expect_code": "SQL_NOT_READ_ONLY", "expect": "rejected", "query": "删除订单", "retryable": false}
{"id": "c20", "category": "结构", "layer": "guard", "sql": "SELECT NULL AS gmv FROM fact_order", "expect_code": "SQL_CONSTANT_PROJECTION", "expect": "corrected", "query": "总销售额", "retryable": true}
