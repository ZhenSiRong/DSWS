{
  "steps": {
    "version": 1,
    "stages": [
      {
        "id": 1,
        "label": "抽取关键词",
        "nodes": [
          "extract_keywords"
        ]
      },
      {
        "id": 2,
        "label": "召回",
        "nodes": [
          "recall_column",
          "recall_value",
          "recall_metric"
        ]
      },
      {
        "id": 3,
        "label": "合并召回",
        "nodes": [
          "merge_retrieved_info"
        ]
      },
      {
        "id": 4,
        "label": "过滤表",
        "nodes": [
          "filter_table"
        ]
      },
      {
        "id": 5,
        "label": "过滤指标",
        "nodes": [
          "filter_metric"
        ]
      },
      {
        "id": 6,
        "label": "补充上下文",
        "nodes": [
          "add_extra_context"
        ]
      },
      {
        "id": 7,
        "label": "生成 SQL",
        "nodes": [
          "generate_sql"
        ]
      },
      {
        "id": 8,
        "label": "校验 SQL",
        "nodes": [
          "validate_sql"
        ]
      },
      {
        "id": 9,
        "label": "校正 SQL",
        "nodes": [
          "correct_sql"
        ]
      },
      {
        "id": 10,
        "label": "执行 SQL",
        "nodes": [
          "run_sql"
        ]
      }
    ],
    "steps": [
      {
        "id": "extract_keywords",
        "label": "抽取关键词",
        "stage": 1
      },
      {
        "id": "recall_column",
        "label": "召回字段信息",
        "stage": 2
      },
      {
        "id": "recall_value",
        "label": "召回字段取值",
        "stage": 2
      },
      {
        "id": "recall_metric",
        "label": "召回指标信息",
        "stage": 2
      },
      {
        "id": "merge_retrieved_info",
        "label": "合并召回信息",
        "stage": 3
      },
      {
        "id": "filter_table",
        "label": "过滤表信息",
        "stage": 4
      },
      {
        "id": "filter_metric",
        "label": "过滤指标信息",
        "stage": 5
      },
      {
        "id": "add_extra_context",
        "label": "添加额外上下文",
        "stage": 6
      },
      {
        "id": "generate_sql",
        "label": "生成SQL",
        "stage": 7
      },
      {
        "id": "validate_sql",
        "label": "校验SQL",
        "stage": 8
      },
      {
        "id": "correct_sql",
        "label": "校正SQL",
        "conditional": true,
        "stage": 9
      },
      {
        "id": "run_sql",
        "label": "执行SQL",
        "stage": 10
      }
    ]
  },
  "errors": {
    "version": 1,
    "classes": [
      "failure",
      "empty",
      "cancelled"
    ],
    "codes": {
      "SQL_REJECTED": {
        "label": "SQL 被安全策略拒绝",
        "class": "failure",
        "retryable": false,
        "message": "SQL 未通过安全策略校验，已拒绝执行。"
      },
      "SQL_SYNTAX": {
        "label": "SQL 语法错误",
        "class": "failure",
        "retryable": true,
        "message": "SQL 无法被解析，语法不合法。"
      },
      "SQL_UNKNOWN_COLUMN": {
        "label": "引用了不存在的列",
        "class": "failure",
        "retryable": true,
        "message": "SQL 引用了 schema 里不存在的列。"
      },
      "EMPTY_RESULT": {
        "label": "查询成功但没有数据",
        "class": "empty",
        "retryable": false,
        "message": "查询执行成功，但没有符合条件的数据。"
      },
      "LLM_REFUSAL": {
        "label": "模型明确拒答",
        "class": "failure",
        "retryable": false,
        "message": "模型判断这个问题无法用现有数据回答，已拒答。"
      },
      "TIMEOUT": {
        "label": "执行超时",
        "class": "failure",
        "retryable": false,
        "message": "SQL 执行超时，已中止。"
      },
      "CANCELLED": {
        "label": "用户取消",
        "class": "cancelled",
        "retryable": false,
        "message": "本次问数已被用户取消。"
      },
      "SQL_UNKNOWN_TABLE": {
        "label": "引用了不存在的表",
        "class": "failure",
        "retryable": true,
        "message": "SQL 引用了 schema 里不存在的表。"
      },
      "SQL_NOT_READ_ONLY": {
        "label": "不是只读查询",
        "class": "failure",
        "retryable": false,
        "message": "SQL 不是只读查询，已拒绝。"
      },
      "SQL_MULTIPLE_STATEMENTS": {
        "label": "不是单条语句",
        "class": "failure",
        "retryable": false,
        "message": "SQL 必须只有一条语句。"
      },
      "SQL_CONSTANT_PROJECTION": {
        "label": "投影了常量",
        "class": "failure",
        "retryable": true,
        "message": "SELECT 列表里出现了字面量常量或 NULL。"
      },
      "SQL_MISSING_ORDER_BY": {
        "label": "缺 ORDER BY",
        "class": "failure",
        "retryable": true,
        "message": "问题有排名意图，SQL 必须带 ORDER BY。"
      },
      "SQL_MISSING_LIMIT": {
        "label": "缺 LIMIT",
        "class": "failure",
        "retryable": true,
        "message": "问题限定了名次，SQL 必须带 LIMIT。"
      },
      "SQL_EMPTY": {
        "label": "SQL 为空",
        "class": "failure",
        "retryable": false,
        "message": "生成结果是空的，没有可执行的 SQL。"
      },
      "SQL_EXECUTION_ERROR": {
        "label": "数据库执行出错",
        "class": "failure",
        "retryable": false,
        "message": "数据库执行这条 SQL 时出错。"
      },
      "INTERNAL_ERROR": {
        "label": "系统内部错误",
        "class": "failure",
        "retryable": false,
        "message": "系统内部错误，本次问数未能完成。"
      }
    }
  }
}
