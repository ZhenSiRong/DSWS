%% 10 · S4 生成 SQL 流水线
%% 主线：上下文 → 槽位 → 提示词 → 生成器 → 输出 schema → guard 静态校验
%%{init: {"themeVariables": {"noteBkgColor": "#f9fafb", "noteBorderColor": "#6b7280", "noteTextColor": "#374151"}, "sequence": {"actorMargin": 45, "width": 130, "messageMargin": 32, "boxMargin": 8, "noteMargin": 8, "mirrorActors": false}}}%%
sequenceDiagram
    autonumber
    participant AR as AgentRunner
    participant CB as ContextBuilder
    participant SB as SlotBuilder
    participant PR as PromptRenderer
    participant GE as Generator
    participant LL as LLM
    participant OS as OutputSchema
    participant GD as Guard

    AR->>CB: 8 阶段上下文
    CB-->>AR: GenerateContext
    AR->>SB: build_slots(context) 7 个槽位
    SB-->>AR: slots
    AR->>PR: render_prompt("generate_sql", slots)
    PR-->>AR: prompt（缺槽直接抛 PromptSlotError）

    AR->>GE: generate(context, prompt)
    alt 配了 LLM 环境变量
        GE->>LL: HTTP 调用
        LL-->>GE: JSON 载荷
    else 未配（默认）
        GE->>GE: DeterministicGenerator 规则命中
    end
    GE-->>AR: payload

    AR->>OS: validate_payload(payload, "sql_or_refusal")
    alt 形状不合法
        OS-->>AR: problem → Refusal(INVALID_OUTPUT)
    else 形状合法
        OS-->>AR: sql 或 refusal
    end

    AR->>GD: check_sql(sql, context, query)
    alt 有违规
        GD-->>AR: GuardReport(False) → 降级为 Refusal
    else 全部通过
        GD-->>AR: GuardReport(True)
    end

    opt 校验失败且 retryable=true（S6 编排器）
        AR->>AR: correct_sql 最多 1 次，然后重新校验
    end
