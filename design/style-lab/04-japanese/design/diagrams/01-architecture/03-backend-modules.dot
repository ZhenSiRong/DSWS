// 03 · backend/app 模块依赖（分层，聚合到文件组；逐文件清单见 inventory/software-census.md §3）
// 图例：实线 import，虚线 运行时调用；橙=构建时，紫=查询时，红=安全，蓝=契约/共享，青=存储。
digraph backend_modules {
  graph [
    rankdir=TB,
    newrank=true,
    fontname="Noto Sans CJK SC",
    fontsize=12,
    labelloc="t",
    label="03 · backend/app 模块依赖\n实线 = import，虚线 = 运行时调用；橙=构建时，紫=查询时，红=安全，蓝=契约/共享，青=存储",
    bgcolor="white",
    splines=true,
    nodesep=0.3,
    ranksep=0.62
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=10,
    penwidth=1.2,
    margin="0.08,0.04",
    fillcolor="#f9fafb",
    color="#6b7280",
    fontcolor="#374151"
  ];
  edge [
    fontname="Noto Sans CJK SC",
    fontsize=8,
    color="#6b7280",
    fontcolor="#374151",
    arrowsize=0.5
  ];

  // 入口层
  bcli [label="build_meta_knowledge\nS2 CLI 入口", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];
  main [label="main\n5 个 HTTP 端点", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  rpipeline [label="recall.pipeline\nS3 阶段验收入口", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];

  // 编排 / 构建 / 召回
  bpipeline [label="build.pipeline\nbuild / verify", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];
  orch [label="agent.orchestrator\nAgentRunner", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  afail [label="agent.validate/correct/errors/cancel\n闸门·校正·16 码·取消", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  rclients [label="recall.clients\nES/Qdrant/Meta", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];

  // 实现层
  bplan [label="build.plan + config", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];
  gpipe [label="generate.pipeline\ndraft / validate", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  gctx [label="generate.context\n8 个阶段", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  cat [label="recall.catalog + keywords\n运行时内存目录", fillcolor="#eff6ff", color="#1d4ed8", fontcolor="#1e3a8a"];
  spol [label="security.policy\nenforce()", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  sexe [label="security.executor + config\nReadOnlyExecutor", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];

  // 叶子 / 共享层
  bres [label="build.*_store + embedding\nMeta / ES / Qdrant", fillcolor="#fff7ed", color="#b45309", fontcolor="#7c2d12"];
  gguard [label="generate.guard\nAST 静态校验", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  gprompt [label="generate.prompts + provider\n7 槽位 / 确定性·HTTP", fillcolor="#f5f3ff", color="#7c3aed", fontcolor="#4c1d95"];
  lex [label="sqllex\n词法扫描", fillcolor="#eff6ff", color="#1d4ed8", fontcolor="#1e3a8a"];
  sch [label="schema_contract\nS1 契约校验", fillcolor="#eff6ff", color="#1d4ed8", fontcolor="#1e3a8a"];

  // 存储
  mysql [label="MySQL\nMeta + dw", shape=cylinder, fillcolor="#ecfdf5", color="#0f766e", fontcolor="#064e3b"];
  es [label="Elasticsearch\n取值索引", shape=cylinder, fillcolor="#ecfdf5", color="#0f766e", fontcolor="#064e3b"];
  qdrant [label="Qdrant\n向量索引", shape=cylinder, fillcolor="#ecfdf5", color="#0f766e", fontcolor="#064e3b"];

  // 分层（自上而下）
  { rank=same; bcli; main; rpipeline; }
  { rank=same; bpipeline; orch; afail; rclients; }
  { rank=same; bplan; gpipe; gctx; cat; spol; sexe; }
  { rank=same; bres; gguard; gprompt; lex; sch; }
  { rank=same; mysql; es; qdrant; }

  // 入口 → 编排
  main -> orch [label="import"];
  main -> afail [label="import"];
  bcli -> bpipeline [label="import"];
  bcli -> bplan [label="import"];
  rpipeline -> rclients [label="import"];
  rpipeline -> cat [label="import"];

  // 编排 → 各层
  orch -> afail [label="import"];
  orch -> gpipe [label="import"];
  orch -> gctx [label="import"];
  orch -> sexe [label="import"];
  afail -> gguard [style=dashed, label="调用"];
  afail -> spol [style=dashed, label="调用"];
  afail -> gprompt [label="import"];

  // 生成 / 安全 / 构建内部
  gpipe -> gctx [label="import"];
  gpipe -> gguard [label="import"];
  gpipe -> gprompt [label="import"];
  gctx -> cat [label="import"];
  spol -> cat [label="import"];
  spol -> lex [label="import"];
  sexe -> spol [label="import"];
  bpipeline -> bplan [label="import"];
  bpipeline -> bres [label="import"];
  bpipeline -> sch [label="import"];
  bplan -> bres [label="import"];
  bplan -> sch [label="import"];
  rclients -> bplan [label="import"];
  rclients -> bres [label="import"];
  gguard -> lex [label="import"];
  cat -> sch [label="import"];

  // 存储读写（运行时）
  bpipeline -> mysql [style=dashed, label="写 44 行"];
  bpipeline -> es [style=dashed, label="写 76 条"];
  bpipeline -> qdrant [style=dashed, label="写 120 点"];
  rclients -> mysql [style=dashed, label="读快照"];
  rclients -> es [style=dashed, label="msearch"];
  rclients -> qdrant [style=dashed, label="向量检索"];
  sexe -> mysql [style=dashed, label="只读 SELECT"];
}
