%% 22 · SQL 策略判定流程（六关 + 收尾）
%%{init: {"flowchart": {"diagramPadding": 0, "wrappingWidth": 340}}}%%
flowchart TD
    A["候选 SQL"] --> G1["① 单语句<br/>S4 guard + S5 policy"]
    G1 -->|"通过"| G2["② 只读<br/>根节点 Select，无写节点"]
    G2 -->|"通过"| G3["③ 表白名单<br/>S5：契约派生，库名 dw"]
    G3 -->|"通过"| G4["④ 列白名单<br/>S5：限定符解析别名后比对"]
    G4 -->|"通过"| G5["⑤ 常量投影<br/>S4 guard：SELECT 列表"]
    G5 -->|"通过"| G6["⑥ ORDER BY / LIMIT<br/>S4 guard：排名意图"]
    G6 -->|"通过"| G7["S5 收尾<br/>补 LIMIT ≤ 1000，去注释，重新序列化"]
    G7 -->|"放行"| P["执行 decision.sql<br/>不是原始文本"]
    P --> DB[("dw_reader 只读连接")]

    G1 -->|"多条语句"| R["拒绝：不建立连接"]
    G2 -->|"写操作 / 集合运算 / 危险函数"| R
    G3 -->|"表不在契约白名单"| R
    G4 -->|"列不在契约白名单"| R
    G5 -->|"字面量 / NULL 投影"| R
    G6 -->|"缺 ORDER BY / LIMIT"| R
    R --> C["通道：guard 用具体码<br/>policy 用 SQL_REJECTED + reason_code"]

    N["读图顺序 = 六个必答问题<br/>实际调用：guard 先跑完，policy 再跑一遍<br/>两关各自独立拒绝，顺序不影响结论"]

